# Python / environment
.venv/
__pycache__/
*.pyc

# Secrets
.env

# Pipeline state, intermediates and caches (regenerated by `python -m automatio run`)
build/
cache/
media/

# Generated media: only code is tracked (rebuild with `python -m automatio run <production>`)
assets/
output/
*.wav
*.mp3
*.mp4
*.srt

# Editors / OS
.DS_Store
.idea/
.vscode/

# Packaging (editable installs)
*.egg-info/

# Operator-specific overrides (see local/README.md): only the README and examples are tracked
local/*
!local/README.md
!local/*.example.*
